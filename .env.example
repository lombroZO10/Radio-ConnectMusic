# Segredos do Discord. Nunca envie o arquivo .env para o Git.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Opcional: use durante o desenvolvimento para publicar comandos imediatamente
# em apenas um servidor. Vazio publica comandos globais.
DISCORD_DEV_GUILD_ID=

# Opcional: sobrescreve o nível definido em config/radio.config.json.
LOG_LEVEL=
