{
  "name": "radio-connect-music-24-7",
  "version": "0.1.0",
  "private": true,
  "description": "Web radio profissional para Discord, portável e preparada para hospedagem Linux.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "esbuild": false
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --dns-result-order=ipv4first build/index.js",
    "discord:deploy": "tsx scripts/deploy-commands.ts",
    "check": "npm run typecheck && npm run lint && npm run test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.3",
    "ffmpeg-static": "^5.3.0",
    "opusscript": "^0.0.8",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.2",
    "prism-media": "^1.3.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.0.15"
  }
}
